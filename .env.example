# ── Groq AI ─────────────────────────────────────────────
# Option A (simple): paste your Groq key here. It is bundled into the app,
# so anyone who downloads the build can read it. Fine for friends/class.
# Leave empty if you use Option B.
VITE_GROQ_API_KEY=""

# Option B (safe, recommended for public deploys): serverless proxy.
# Set to "1" AND set GROQ_API_KEY in your Vercel project environment variables.
VITE_USE_SERVER_AI=""

# ── Supabase (global leaderboard) ───────────────────────
# From: Supabase → Project Settings → API
# Also run supabase/schema.sql once in the SQL editor.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
